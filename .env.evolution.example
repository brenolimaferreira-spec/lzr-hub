# Copie para `.env.evolution` (que é gitignorado) e preencha.
#
# EVOLUTION_API_KEY é o que autentica você no Evolution Manager e no n8n.
# Escolha uma string longa e aleatória — não é senha de usuário, é chave de API.
# Gerar uma: openssl rand -hex 32
EVOLUTION_API_KEY=troque-por-uma-chave-aleatoria-longa

# Senha do Postgres da Evolution. Banco separado do LZR HUB de propósito: são
# dois sistemas com ciclos de vida diferentes, e derrubar um não deve levar o outro.
EVOLUTION_DB_PASSWORD=troque-tambem

# Porta local da Evolution. A 8080 costuma estar ocupada (Apache/XAMPP).
EVOLUTION_PORT=8081
