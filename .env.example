# Copie para .env.local apenas no ambiente correspondente. Nunca versione segredos.
# No Railway, o plugin Postgres injeta DATABASE_URL automaticamente ao conectar o serviço.
DATABASE_URL=
LZR_ENV=local
NEXT_PUBLIC_LZR_ENV=local
LZR_RUNTIME_MODE=mock
IXC_MODE=disabled
IXC_BASE_URL=
IXC_API_TOKEN=
IXC_ALLOWED_CUSTOMER_IDS=
IXC_TIMEOUT_MS=3500
IXC_RETRY_LIMIT=1
IXC_CACHE_TTL_SECONDS=300
IXC_RATE_LIMIT_PER_MINUTE=30
IXC_SYNC_SCHEDULE_ENABLED=false
IXC_WRITE_ENABLED=false
STAGING_JOB_SECRET=
PILOT_MODE=disabled
PILOT_ALLOWED_USER_IDS=
FEATURE_CHATWOOT=false
FEATURE_EVOLUTION=false
FEATURE_META_WHATSAPP=false
# Canal oficial da Meta (WhatsApp Business Platform / Cloud API).
# META_VERIFY_TOKEN: você escolhe, e repete no painel da Meta ao cadastrar o
# webhook. Serve só ao handshake de verificação — NÃO é o que protege as
# mensagens.
META_VERIFY_TOKEN=
# META_APP_SECRET: o "App Secret" do seu aplicativo na Meta. É ele que assina
# cada webhook (X-Hub-Signature-256) e é a segurança de verdade da rota.
META_APP_SECRET=
FEATURE_IXC_WRITE=false
FEATURE_LANGFUSE=false
FEATURE_PGVECTOR=false
FEATURE_QUEUES=false
# Ao habilitar localmente, use o mesmo segredo configurado no docker-compose.integrations.yml.
QUEUE_SERVICE_URL=http://127.0.0.1:8790
QUEUE_SERVICE_SECRET=
REDIS_URL=redis://127.0.0.1:6380/0
QUEUE_PREFIX=lzr-local
QUEUE_WORKER_CONCURRENCY=5
FEATURE_AGENT_HOMOLOGATION_PROFILES=false
FEATURE_N8N_CHANNEL=false
# Resposta automática ao cliente. Desligada = canal recebe, classifica e sugere, mas não envia nada.
# Libera leitura da base inteira do IXC, em vez de só a allowlist. Exige FEATURE_AUTH=true.
FEATURE_IXC_FULL_BASE=false
FEATURE_N8N_AUTOREPLY=false
N8N_CHANNEL_SECRET=
# Ingestão de alertas de rede reais, vindos de um webhook do Telegram (grupo
# onde o monitoramento posta queda/normalização). Ver app/api/integrations/telegram/webhook.
FEATURE_TELEGRAM_ALERTS=false
# Valor do secret_token passado ao Telegram em setWebhook; ele ecoa em todo POST.
TELEGRAM_WEBHOOK_SECRET=
# Exige login e aplica RBAC nas rotas. OBRIGATÓRIO ligar antes de dado real (M4).
FEATURE_AUTH=false
# Provisionamento de usuários a partir do IXC (mapa id_grupo -> papel do LZR HUB).
# Grupo não mapeado vira "Somente leitura" (fail-closed).
IXC_GROUP_ROLE_MAP=
# Contas que a sincronização nunca altera (evita rebaixar o admin local). Separe por vírgula.
IXC_SYNC_PROTECTED_EMAILS=
# Transporte HTTP do IXC. O IXC exige GET com corpo JSON nas listagens (padrão).
# Use POST apenas se estiver falando com a ponte antiga, que fazia essa conversão.
IXC_HTTP_METHOD=GET
# Observabilidade da IA (Langfuse). Chaves em Settings -> API Keys no painel do Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Padrão: nuvem EU. Troque para https://us.cloud.langfuse.com se a conta for da região US.
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Classificação de intenção por modelo de linguagem (Groq).
# Sem GROQ_API_KEY nada é enviado para fora e a classificação continua por regex.
FEATURE_LLM_INTENT=false
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
